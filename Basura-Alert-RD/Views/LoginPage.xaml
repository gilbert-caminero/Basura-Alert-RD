<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Basura_Alert_RD.ViewModels"
             x:Class="Basura_Alert_RD.Views.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="#F8FAFC">

    <!-- Asignación explícita del BindingContext -->
    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" VerticalOptions="Center">

            <!-- Logo o Título -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="♻️" FontSize="60" HorizontalOptions="Center" />
                <Label Text="Basura-Alert-RD" FontSize="22" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True" BorderColor="#CBD5E1">
                <VerticalStackLayout Spacing="15">

                    <!-- Campo Usuario -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Usuario" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" />
                        <Entry Text="{Binding Usuario}" 
                               Placeholder="Ingresa tu usuario" 
                               BackgroundColor="White" />
                    </VerticalStackLayout>

                    <!-- Campo Contraseña -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Contraseña" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" />
                        <Entry Text="{Binding Contrasena}" 
                               Placeholder="Ingresa tu contraseña" 
                               IsPassword="True" 
                               BackgroundColor="White" />
                    </VerticalStackLayout>

                    <!-- Botón Iniciar Sesión -->
                    <Button Text="Iniciar Sesión" 
                            Command="{Binding IniciarSesionCommand}"
                            BackgroundColor="#16A34A" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="10" 
                            HeightRequest="48" 
                            Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>