<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Basura_Alert_RD.Views.LoginPage"
             Title="Inicio de Sesión"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

            <Label Text="Basura-Alert-RD"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2E7D32" />

            <Label Text="Sistema Comunitario de Alertas"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#666666"
                   Margin="0,0,0,20" />

            <Frame BackgroundColor="White" CornerRadius="10" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Correo Electrónico" TextColor="#333333" FontAttributes="Bold" />
                    <Entry Placeholder="ejemplo@correo.com"
                           Keyboard="Email"
                           BackgroundColor="#FAFAFA"
                           TextColor="Black"
                           PlaceholderColor="Gray" />

                    <Label Text="Contraseña" TextColor="#333333" FontAttributes="Bold" />
                    <Entry Placeholder="••••••••"
                           IsPassword="True"
                           BackgroundColor="#FAFAFA"
                           TextColor="Black"
                           PlaceholderColor="Gray" />

                    <Button x:Name="BtnIngresar"
                            Text="Iniciar Sesión"
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="45"
                            Margin="0,10,0,0"
                            Clicked="OnLoginClicked" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>