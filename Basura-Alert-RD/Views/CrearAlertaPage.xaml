<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Basura_Alert_RD.ViewModels"
             x:Class="Basura_Alert_RD.Views.CrearAlertaPage"
             Title="Crear Alerta">

    <ContentPage.BindingContext>
        <vm:CrearAlertaViewModel />
    </ContentPage.BindingContext>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Label Text="Reportar Nueva Alerta" FontSize="22" FontAttributes="Bold" TextColor="#166534" />

            <!-- Campo Título -->
            <Label Text="Título de la Alerta" FontAttributes="Bold" />
            <Entry Placeholder="Ej. Acumulación de basura en la av. principal" Text="{Binding Titulo}" />
            <Label Text="{Binding ErrorTitulo}" TextColor="Red" FontSize="12" IsVisible="{Binding TieneErrorTitulo}" />

            <!-- Campo Ubicación -->
            <Label Text="Ubicación" FontAttributes="Bold" />
            <Entry Placeholder="Ej. Calle Los Pinos, Engombe" Text="{Binding Ubicacion}" />
            <Label Text="{Binding ErrorUbicacion}" TextColor="Red" FontSize="12" IsVisible="{Binding TieneErrorUbicacion}" />

            <!-- Campo Descripción -->
            <Label Text="Descripción" FontAttributes="Bold" />
            <Editor Placeholder="Detalles de la situación..." HeightRequest="100" Text="{Binding Descripcion}" />
            <Label Text="{Binding ErrorDescripcion}" TextColor="Red" FontSize="12" IsVisible="{Binding TieneErrorDescripcion}" />

            <!-- Botón Guardar -->
            <Button Text="Guardar Alerta" 
                    Command="{Binding GuardarAlertaCommand}" 
                    BackgroundColor="#166534" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    Margin="0,15,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>