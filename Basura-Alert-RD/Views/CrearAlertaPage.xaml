<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Basura_Alert_RD.Views.CrearAlertaPage"
             Title="Nuevo Aviso"
             BackgroundColor="#F4F6F8">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="Reportar Recolección" FontSize="22" FontAttributes="Bold" TextColor="#2E7D32" />

            <Entry Placeholder="Sector / Dirección" BackgroundColor="White" TextColor="Black" />
            <Editor Placeholder="Descripción o detalles..." HeightRequest="100" BackgroundColor="White" TextColor="Black" />

            <Button Text="Publicar Alerta" BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>