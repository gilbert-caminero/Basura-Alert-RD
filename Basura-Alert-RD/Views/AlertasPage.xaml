<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Basura_Alert_RD.Views.AlertasPage"
             Title="Registros y Alertas"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Sección de Alertas -->
            <Label Text="Alertas de Recolección" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#2E7D32" />

            <CollectionView x:Name="collectionAlertas" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" CornerRadius="8" Padding="12" Margin="0,4">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Sector}" FontAttributes="Bold" FontSize="15" TextColor="Black" />
                                <Label Text="{Binding ReportadoPor}" FontSize="13" TextColor="#666666" />
                                <Label Text="{Binding FechaHora}" FontSize="11" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Sección de Puntos de Reciclaje -->
            <Label Text="Puntos de Reciclaje Registrados" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#1B5E20" 
                   Margin="0,10,0,0" />

            <CollectionView x:Name="collectionPuntos" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" CornerRadius="8" Padding="12" Margin="0,4">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding NombrePunto}" FontAttributes="Bold" FontSize="15" TextColor="Black" />
                                <Label Text="{Binding Ubicacion}" FontSize="13" TextColor="#666666" />
                                <Label Text="{Binding Horario}" FontSize="11" TextColor="DarkGreen" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>