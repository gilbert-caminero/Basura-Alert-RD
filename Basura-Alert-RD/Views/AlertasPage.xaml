<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Basura_Alert_RD.ViewModels"
             x:Class="Basura_Alert_RD.Views.AlertasPage"
             Title="Gestión General">

    <ContentPage.BindingContext>
        <vm:AlertasViewModel />
    </ContentPage.BindingContext>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="20">

            <!-- SECCIÓN 1: ALERTAS CIUDADANAS -->
            <Label Text="Alertas Ciudadanas" FontSize="18" FontAttributes="Bold" TextColor="#166534" />

            <CollectionView ItemsSource="{Binding Alertas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="12" CornerRadius="8" BorderColor="#CBD5E1">
                            <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Sector}" FontAttributes="Bold" FontSize="15" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding ReportadoPor, StringFormat='Reportado por: {0}'}" FontSize="12" TextColor="#64748B" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding FechaHora, StringFormat='Hora: {0:dd/MM/yyyy hh:mm tt}'}" FontSize="11" TextColor="#059669" FontAttributes="Italic" />

                                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                        Text="Editar" 
                                        BackgroundColor="#F59E0B" 
                                        TextColor="White" 
                                        FontSize="12"
                                        HeightRequest="35"
                                        Margin="0,0,5,0"
                                        Command="{Binding BindingContext.EditarAlertaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                        Text="🗑️" 
                                        BackgroundColor="#EF4444" 
                                        TextColor="White" 
                                        HeightRequest="35"
                                        WidthRequest="40"
                                        Command="{Binding BindingContext.EliminarAlertaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <!-- SECCIÓN 2: PUNTOS DE RECICLAJE -->
            <Label Text="Puntos de Reciclaje" FontSize="18" FontAttributes="Bold" TextColor="#166534" Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding PuntosReciclaje}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="12" CornerRadius="8" BorderColor="#CBD5E1">
                            <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nombre}" FontAttributes="Bold" FontSize="15" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Direccion}" FontSize="12" TextColor="#64748B" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding Horario, StringFormat='Horario: {0}'}" FontSize="11" TextColor="#059669" FontAttributes="Italic" />

                                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                        Text="Editar" 
                                        BackgroundColor="#F59E0B" 
                                        TextColor="White" 
                                        FontSize="12"
                                        HeightRequest="35"
                                        Margin="0,0,5,0"
                                        Command="{Binding BindingContext.EditarPuntoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                        Text="🗑️" 
                                        BackgroundColor="#EF4444" 
                                        TextColor="White" 
                                        HeightRequest="35"
                                        WidthRequest="40"
                                        Command="{Binding BindingContext.EliminarPuntoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>