<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Basura_Alert_RD.App">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta de Colores Moderna y Ecológica -->
            <Color x:Key="PrimaryColor">#15803D</Color>
            <!-- Verde principal -->
            <Color x:Key="PrimaryDark">#166534</Color>
            <!-- Verde oscuro -->
            <Color x:Key="AccentColor">#22C55E</Color>
            <!-- Verde claro de acento -->
            <Color x:Key="BackgroundColor">#F8FAFC</Color>
            <!-- Gris muy claro de fondo -->
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <!-- Blanco para tarjetas -->
            <Color x:Key="TextColor">#0F172A</Color>
            <!-- Texto principal oscuro -->
            <Color x:Key="SubTextColor">#64748B</Color>
            <!-- Texto secundario gris -->
            <Color x:Key="DangerColor">#EF4444</Color>
            <!-- Rojo para eliminar -->
            <Color x:Key="WarningColor">#EAB308</Color>
            <!-- Amarillo para editar -->

            <!-- Estilo global para Títulos -->
            <Style TargetType="Label" x:Key="TitleStyle">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
            </Style>

            <!-- Estilo global para Entradas de Texto (Entry) -->
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
                <Setter Property="PlaceholderColor" Value="#94A3B8"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>

            <!-- Estilo global para Botones Principales -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>